# Production environment. Copy to .env.main on the VPS.
# "example.com" is replaced by the VPS_HOST secret during deployment, so the
# real public host is never committed to git.
ENV_NAME=main
PUBLIC_HOST=example.com
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=8080

DEBUG=false
ALLOWED_HOSTS=example.com,localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://example.com:3000
STATIC_URL=http://example.com:8080/static/
MEDIA_URL=http://example.com:8080/media/
AUTH_COOKIE_SECURE=false
