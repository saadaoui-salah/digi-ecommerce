# Staging environment. Copy to .env.staging on the VPS.
# "example.com" is replaced by the VPS_HOST secret during deployment, so the
# real public host is never committed to git.
ENV_NAME=staging
PUBLIC_HOST=example.com
BACKEND_PORT=8002
FRONTEND_PORT=3002
NGINX_PORT=8079

DEBUG=true
ALLOWED_HOSTS=example.com,localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://example.com:3002
STATIC_URL=/static/
MEDIA_URL=http://example.com:8079/media/
AUTH_COOKIE_SECURE=false
